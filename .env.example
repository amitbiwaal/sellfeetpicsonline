# ------------------------------------------------------------------
# SellFeetOnline configuration
# Copy this file to .env (or run `npm run setup`, which creates it for you).
# ------------------------------------------------------------------

# Public address of the website (used for canonical URLs, sitemap, RSS, social cards)
NEXT_PUBLIC_SITE_URL=https://sellfeetonline.com

# Database. Default: a local SQLite file (great for a VPS / Hostinger Node.js hosting).
# For Vercel, create a free Turso database and use its libsql:// URL + token instead.
DATABASE_URL=file:./data/sellfeetonline.db
# DATABASE_AUTH_TOKEN=

# Secret used to sign admin login sessions. Must be at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# First admin account. Created automatically on the first `npm run setup` / build
# when no admin exists yet. Change the password in Admin → Users after logging in.
ADMIN_EMAIL=admin@sellfeetonline.com
ADMIN_PASSWORD=

# ---------------- Optional ----------------

# Image uploads on Vercel: create a Vercel Blob store and paste its token.
# Without it, uploads are saved to ./storage/uploads (fine on a VPS).
# BLOB_READ_WRITE_TOKEN=

# Change where uploads are stored on disk (default: ./storage/uploads)
# UPLOAD_DIR=

# Email notifications for new contact-form messages (https://resend.com).
# MAIL_FROM must use a domain you verified in Resend.
# RESEND_API_KEY=
# MAIL_FROM=SellFeetOnline <noreply@sellfeetonline.com>

# Only for testing a production build over plain http (not https) on a server:
# INSECURE_COOKIES=true
